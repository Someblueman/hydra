# Claude configuration
.claude/
CLAUDE.md

# OS files
.DS_Store

# Editor files
*.swp
*.swo
*~

# Temporary files
*.tmp

# GitHub Actions
.github/workflows/*.log

# Hydra runtime state (live state lives under $HYDRA_HOME, default ~/.hydra)
.hydra/

# Generated native build and packaging outputs
build/
dist/

# Qualification captures and exploratory reports stay outside the maintained docs.
docs/acceptance/
docs/evidence/*
# The I4 visual pass keeps its bounded before/after screen captures in the tree.
!docs/evidence/i4/
docs/research/

# Python test bytecode
__pycache__/
