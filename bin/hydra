#!/bin/sh
# Hydra - POSIX-compliant CLI for managing parallel AI coding sessions
# Wraps tmux ≥ 3.0 and git worktree

set -eu

# Global variables
# Ensure HOME is set to actual user home directory
if [ -z "${HOME:-}" ] || [ ! -d "${HOME:-}" ]; then
    HOME="$(cd ~ && pwd)"
fi
HYDRA_HOME="${HYDRA_HOME:-$HOME/.hydra}"
HYDRA_1X_MAP="$HYDRA_HOME/map"
HYDRA_VERSION="2.0.0"
export HYDRA_VERSION HYDRA_1X_MAP

# Source helper libraries
# Enhanced library detection with multiple fallback paths
# Try to resolve the real path of the hydra binary
HYDRA_BIN_PATH="$0"
if [ -L "$HYDRA_BIN_PATH" ]; then
    # Follow symlinks if possible (POSIX-compliant approach)
    if command -v readlink >/dev/null 2>&1; then
        # Try GNU readlink -f first, then BSD readlink
        HYDRA_BIN_PATH="$(readlink -f "$HYDRA_BIN_PATH" 2>/dev/null || readlink "$HYDRA_BIN_PATH" 2>/dev/null || echo "$HYDRA_BIN_PATH")"
    fi
fi

# Get the directory containing the hydra binary
if HYDRA_BIN_DIR="$(cd "$(dirname "$HYDRA_BIN_PATH")" 2>/dev/null && pwd)"; then
    : # Successfully got absolute path
else
    # Fallback to dirname if cd fails
    HYDRA_BIN_DIR="$(dirname "$HYDRA_BIN_PATH")"
fi

# Library discovery: HYDRA_ROOT, source ../lib, PREFIX ../lib/hydra, legacy
if [ -n "${HYDRA_ROOT:-}" ] && [ -d "$HYDRA_ROOT/lib" ] && [ -f "$HYDRA_ROOT/lib/git.sh" ]; then
    HYDRA_LIB_DIR="$(cd "$HYDRA_ROOT/lib" && pwd)"
elif [ -d "$HYDRA_BIN_DIR/../lib" ] && [ -f "$HYDRA_BIN_DIR/../lib/git.sh" ]; then
    # Running from a source checkout: bin/../lib
    HYDRA_LIB_DIR="$(cd "$HYDRA_BIN_DIR/../lib" && pwd)"
elif [ -d "$HYDRA_BIN_DIR/../lib/hydra" ] && [ -f "$HYDRA_BIN_DIR/../lib/hydra/git.sh" ]; then
    # PREFIX install: $PREFIX/bin/hydra -> $PREFIX/lib/hydra
    HYDRA_LIB_DIR="$(cd "$HYDRA_BIN_DIR/../lib/hydra" && pwd)"
elif [ -d "/usr/local/lib/hydra" ] && [ -f "/usr/local/lib/hydra/git.sh" ]; then
    # Legacy default prefix
    HYDRA_LIB_DIR="/usr/local/lib/hydra"
else
    echo "Error: Cannot find hydra library directory" >&2
    echo "Precondition: libraries must resolve from the binary (source ../lib or PREFIX ../lib/hydra)." >&2
    echo "Searched in:" >&2
    [ -n "${HYDRA_ROOT:-}" ] && echo "  - $HYDRA_ROOT/lib (HYDRA_ROOT)" >&2
    echo "  - $HYDRA_BIN_DIR/../lib (source checkout)" >&2
    echo "  - $HYDRA_BIN_DIR/../lib/hydra (PREFIX install)" >&2
    echo "  - /usr/local/lib/hydra (legacy)" >&2
    echo "Next: run bin/hydra from a source checkout, set HYDRA_ROOT to that checkout, or reinstall with PREFIX=\$HOME/.local ./install.sh" >&2
    echo "See README Quick Start." >&2
    exit 1
fi

# Lazy library loading - track which libs are loaded
_LOADED_LIBS=""

# Load a library if not already loaded
# Usage: _load_lib <libname>
_load_lib() {
    _lib="$1"
    # Check if already loaded (simple substring check)
    case "$_LOADED_LIBS" in
        *":$_lib:"*) return 0 ;;
    esac
    # shellcheck disable=SC1090
    . "$HYDRA_LIB_DIR/${_lib}.sh"
    _LOADED_LIBS="${_LOADED_LIBS}:${_lib}:"
}

# Load libraries required for a command
# Usage: _load_libs_for_cmd <command>
_load_libs_for_cmd() {
    case "$1" in
        version|help|-v|--version|-h|--help)
            ;;
        fleet-local)
            _load_lib output
            _load_lib locks
            _load_lib git
            _load_lib identity
            _load_lib state_v2
            _load_lib lifecycle
            _load_lib cmd_fleet_local
            ;;
        remote|fleet)
            _load_lib output
            _load_lib cmd_fleet
            ;;
        state|events)
            _load_lib output
            _load_lib locks
            _load_lib identity
            _load_lib state_v2
            _load_lib events
            _load_lib cmd_foundation
            ;;
        snapshot)
            _load_lib output
            _load_lib locks
            _load_lib identity
            _load_lib state_v2
            _load_lib core
            _load_lib cmd_core
            ;;
        init|agent|capabilities|path)
            _load_lib output
            _load_lib paths
            _load_lib locks
            _load_lib git
            _load_lib identity
            _load_lib state_v2
            _load_lib project
            _load_lib profiles
            _load_lib cmd_lifecycle
            ;;
        workflow)
            _load_lib output
            _load_lib paths
            _load_lib locks
            _load_lib git
            _load_lib tmux
            _load_lib state
            _load_lib identity
            _load_lib state_v2
            _load_lib events
            _load_lib project
            _load_lib profiles
            _load_lib lifecycle
            _load_lib operations
            _load_lib parallel
            _load_lib messages
            _load_lib limits
            _load_lib workflow
            _load_lib workflow_runtime
            _load_lib cmd_workflow
            ;;
        lifecycle|outcome|wait|adapter|resume|notify)
            _load_lib output
            _load_lib paths
            _load_lib locks
            _load_lib git
            _load_lib tmux
            _load_lib state
            _load_lib identity
            _load_lib state_v2
            _load_lib events
            _load_lib project
            _load_lib profiles
            _load_lib lifecycle
            _load_lib notify
            _load_lib operations
            _load_lib cmd_evidence
            ;;
        exec|diff|review|provenance)
            _load_lib output
            _load_lib paths
            _load_lib locks
            _load_lib git
            _load_lib tmux
            _load_lib state
            _load_lib identity
            _load_lib state_v2
            _load_lib events
            _load_lib project
            _load_lib profiles
            _load_lib lifecycle
            _load_lib operations
            _load_lib cmd_operations
            ;;
        claim|scope|collision|resource|gate)
            _load_lib output
            _load_lib paths
            _load_lib locks
            _load_lib git
            _load_lib tmux
            _load_lib state
            _load_lib identity
            _load_lib state_v2
            _load_lib events
            _load_lib project
            _load_lib profiles
            _load_lib lifecycle
            _load_lib operations
            _load_lib parallel
            _load_lib cmd_parallel
            ;;
        context|sync|land|integrate)
            _load_lib output
            _load_lib paths
            _load_lib locks
            _load_lib git
            _load_lib tmux
            _load_lib state
            _load_lib identity
            _load_lib state_v2
            _load_lib events
            _load_lib project
            _load_lib profiles
            _load_lib lifecycle
            _load_lib notify
            _load_lib hooks
            _load_lib messages
            _load_lib operations
            _load_lib parallel
            _load_lib integration
            _load_lib integration_verified
            _load_lib integration_verified_actions
            _load_lib kill
            _load_lib limits
            _load_lib spawn
            _load_lib cmd_integration
            ;;
        du|gc|worktree)
            _load_lib output
            _load_lib paths
            _load_lib locks
            _load_lib git
            _load_lib tmux
            _load_lib state
            _load_lib identity
            _load_lib state_v2
            _load_lib project
            _load_lib profiles
            _load_lib lifecycle
            _load_lib parallel
            _load_lib integration
            _load_lib worktree_ops
            _load_lib cmd_worktree_ops
            ;;
        spawn)
            _load_lib output
            _load_lib paths
            _load_lib locks
            _load_lib git
            _load_lib tmux
            _load_lib layout
            _load_lib state
            _load_lib identity
            _load_lib state_v2
            _load_lib events
            _load_lib project
            _load_lib profiles
            _load_lib lifecycle
            _load_lib notify
            _load_lib operations
            _load_lib parallel
            _load_lib hooks
            _load_lib yaml
            _load_lib spawn
            _load_lib spawn_bulk
            _load_lib github
            _load_lib limits
            _load_lib kill
            _load_lib cmd_spawn
            _load_lib cmd_list
            _load_lib cmd_session
            ;;
        list|switch|status|cycle-layout)
            _load_lib output
            _load_lib locks
            _load_lib state
            _load_lib tmux
            _load_lib identity
            _load_lib state_v2
            _load_lib lifecycle
            _load_lib operations
            _load_lib layout
            _load_lib github
            _load_lib cmd_list
            _load_lib cmd_session
            ;;
        kill)
            _load_lib output
            _load_lib paths
            _load_lib locks
            _load_lib git
            _load_lib tmux
            _load_lib state
            _load_lib identity
            _load_lib state_v2
            _load_lib events
            _load_lib project
            _load_lib lifecycle
            _load_lib parallel
            _load_lib notify
            _load_lib hooks
            _load_lib messages
            _load_lib kill
            _load_lib limits
            _load_lib spawn
            _load_lib cmd_session
            ;;
        group|send|recv)
            _load_lib output
            _load_lib state
            _load_lib tmux
            _load_lib locks
            _load_lib identity
            _load_lib state_v2
            _load_lib messages
            _load_lib cmd_group
            _load_lib cmd_messages
            ;;
        pr|template)
            _load_lib locks
            _load_lib state
            _load_lib identity
            _load_lib state_v2
            _load_lib github
            _load_lib template
            _load_lib cmd_github
            ;;
        tail|broadcast|wait-idle)
            _load_lib locks
            _load_lib state
            _load_lib tmux
            _load_lib identity
            _load_lib state_v2
            _load_lib cmd_session_ops
            ;;
        regenerate)
            _load_lib output
            _load_lib paths
            _load_lib locks
            _load_lib git
            _load_lib tmux
            _load_lib layout
            _load_lib state
            _load_lib identity
            _load_lib state_v2
            _load_lib events
            _load_lib project
            _load_lib profiles
            _load_lib lifecycle
            _load_lib notify
            _load_lib hooks
            _load_lib yaml
            _load_lib spawn
            _load_lib cmd_queue
            _load_lib cmd_evidence
            ;;
        doctor|cleanup)
            _load_lib paths
            _load_lib maintenance
            _load_lib tmux
            _load_lib state
            _load_lib git
            _load_lib locks
            _load_lib identity
            _load_lib state_v2
            _load_lib output
            _load_lib messages
            _load_lib spawn
            _load_lib cmd_queue
            _load_lib cmd_maintenance
            ;;
        dashboard|dashboard-exit)
            _load_lib locks
            _load_lib state
            _load_lib tmux
            _load_lib identity
            _load_lib state_v2
            _load_lib dashboard
            ;;
        tui)
            _load_lib output
            _load_lib paths
            _load_lib locks
            _load_lib identity
            _load_lib git
            _load_lib tmux
            _load_lib layout
            _load_lib state
            _load_lib state_v2
            _load_lib project
            _load_lib profiles
            _load_lib notify
            _load_lib events
            _load_lib lifecycle
            _load_lib hooks
            _load_lib yaml
            _load_lib spawn
            _load_lib spawn_bulk
            _load_lib kill
            _load_lib limits
            _load_lib maintenance
            _load_lib parallel
            _load_lib github
            _load_lib dashboard
            _load_lib cmd_spawn
            _load_lib cmd_queue
            _load_lib cmd_list
            _load_lib cmd_session
            _load_lib cmd_messages
            _load_lib tui
            ;;
        queue)
            _load_lib output
            _load_lib state
            _load_lib locks
            _load_lib identity
            _load_lib state_v2
            _load_lib limits
            _load_lib spawn
            _load_lib cmd_queue
            ;;
        completion)
            _load_lib completion_bash
            _load_lib completion_zsh
            _load_lib completion_fish
            _load_lib completion
            _load_lib cmd_completion
            ;;
        *)
            _load_lib output
            _load_lib paths
            _load_lib locks
            _load_lib git
            _load_lib tmux
            _load_lib layout
            _load_lib state
            _load_lib completion
            _load_lib dashboard
            _load_lib github
            _load_lib hooks
            _load_lib yaml
            _load_lib spawn
            _load_lib spawn_bulk
            _load_lib kill
            _load_lib limits
            _load_lib maintenance
            _load_lib tui
            _load_lib cmd_spawn
            _load_lib cmd_queue
            _load_lib cmd_list
            _load_lib cmd_session
            _load_lib cmd_group
            _load_lib cmd_messages
            _load_lib cmd_github
            _load_lib cmd_session_ops
            _load_lib cmd_maintenance
            _load_lib cmd_completion
            ;;
    esac
}

# Export paths for downstream helpers (e.g., safe tmux run-shell bindings)
export HYDRA_LIB_DIR
export HYDRA_BIN_DIR
# Resolve the absolute path to the current hydra binary for secure bindings
HYDRA_BIN_CMD="${HYDRA_BIN_PATH}"
export HYDRA_BIN_CMD

# Initialize Hydra home directory
init_hydra_home() {
    if ! mkdir -p "$HYDRA_HOME" 2>/dev/null; then
        echo "Error: HYDRA_HOME is not writable: $HYDRA_HOME" >&2
        echo "Next: export HYDRA_HOME=\"\$HOME/.hydra\" and ensure that directory is writable, or see README Quick Start" >&2
        exit 1
    fi
    if [ ! -w "$HYDRA_HOME" ]; then
        echo "Error: HYDRA_HOME is not writable: $HYDRA_HOME" >&2
        echo "Next: chmod u+w \"$HYDRA_HOME\" or export HYDRA_HOME to a writable directory (see README Quick Start)" >&2
        exit 1
    fi
}

# Load the top-level usage and dispatcher after library discovery is ready.
_load_lib cli

# Command implementations live in lib/cmd_*.sh

main "$@"
