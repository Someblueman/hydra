#!/bin/sh
# Hydra - POSIX-compliant CLI for managing parallel AI coding sessions
# Wraps tmux ≥ 3.0 and git worktree

set -eu

# Global variables
# Ensure HOME is set to actual user home directory
if [ -z "${HOME:-}" ] || [ ! -d "${HOME:-}" ]; then
    HOME="$(cd ~ && pwd)"
fi
HYDRA_HOME="${HYDRA_HOME:-$HOME/.hydra}"
HYDRA_1X_MAP="$HYDRA_HOME/map"
HYDRA_VERSION="2.2.1"
export HYDRA_VERSION HYDRA_1X_MAP

# Source helper libraries
# Enhanced library detection with multiple fallback paths
# Try to resolve the real path of the hydra binary
HYDRA_BIN_PATH="$0"
if [ -L "$HYDRA_BIN_PATH" ]; then
    # Follow symlinks if possible (POSIX-compliant approach)
    if command -v readlink >/dev/null 2>&1; then
        # Try GNU readlink -f first, then BSD readlink
        HYDRA_BIN_PATH="$(readlink -f "$HYDRA_BIN_PATH" 2>/dev/null || readlink "$HYDRA_BIN_PATH" 2>/dev/null || echo "$HYDRA_BIN_PATH")"
    fi
fi

# Get the directory containing the hydra binary
if HYDRA_BIN_DIR="$(cd "$(dirname "$HYDRA_BIN_PATH")" 2>/dev/null && pwd)"; then
    : # Successfully got absolute path
else
    # Fallback to dirname if cd fails
    HYDRA_BIN_DIR="$(dirname "$HYDRA_BIN_PATH")"
fi

# Library discovery: HYDRA_ROOT, source ../lib, PREFIX ../lib/hydra, legacy
if [ -n "${HYDRA_ROOT:-}" ] && [ -d "$HYDRA_ROOT/lib" ] && [ -f "$HYDRA_ROOT/lib/git.sh" ]; then
    HYDRA_LIB_DIR="$(cd "$HYDRA_ROOT/lib" && pwd)"
elif [ -d "$HYDRA_BIN_DIR/../lib" ] && [ -f "$HYDRA_BIN_DIR/../lib/git.sh" ]; then
    # Running from a source checkout: bin/../lib
    HYDRA_LIB_DIR="$(cd "$HYDRA_BIN_DIR/../lib" && pwd)"
elif [ -d "$HYDRA_BIN_DIR/../lib/hydra" ] && [ -f "$HYDRA_BIN_DIR/../lib/hydra/git.sh" ]; then
    # PREFIX install: $PREFIX/bin/hydra -> $PREFIX/lib/hydra
    HYDRA_LIB_DIR="$(cd "$HYDRA_BIN_DIR/../lib/hydra" && pwd)"
elif [ -d "/usr/local/lib/hydra" ] && [ -f "/usr/local/lib/hydra/git.sh" ]; then
    # Legacy default prefix
    HYDRA_LIB_DIR="/usr/local/lib/hydra"
else
    echo "Error: Cannot find hydra library directory" >&2
    echo "Precondition: libraries must resolve from the binary (source ../lib or PREFIX ../lib/hydra)." >&2
    echo "Searched in:" >&2
    [ -n "${HYDRA_ROOT:-}" ] && echo "  - $HYDRA_ROOT/lib (HYDRA_ROOT)" >&2
    echo "  - $HYDRA_BIN_DIR/../lib (source checkout)" >&2
    echo "  - $HYDRA_BIN_DIR/../lib/hydra (PREFIX install)" >&2
    echo "  - /usr/local/lib/hydra (legacy)" >&2
    echo "Next: run bin/hydra from a source checkout, set HYDRA_ROOT to that checkout, or reinstall with PREFIX=\$HOME/.local ./install.sh" >&2
    echo "See README Quick Start." >&2
    exit 1
fi

# Lazy library loading - track which libs are loaded
_LOADED_LIBS=""

# Load a library if not already loaded
# Usage: _load_lib <libname>
_load_lib() {
    _lib="$1"
    # Check if already loaded (simple substring check)
    case "$_LOADED_LIBS" in
        *":$_lib:"*) return 0 ;;
    esac
    # shellcheck disable=SC1090
    . "$HYDRA_LIB_DIR/${_lib}.sh"
    _LOADED_LIBS="${_LOADED_LIBS}:${_lib}:"
}

# Load ordered dependencies using function-local positional arguments.
_load_libs() {
    while [ "$#" -gt 0 ]; do
        _load_lib "$1"
        shift
    done
}

# Basic UI actions are loaded only when native dispatch falls back or --basic is selected.
_load_tui_basic_libs() {
    _load_libs layout hooks yaml spawn spawn_bulk kill parallel github dashboard \
        cmd_spawn cmd_queue cmd_list cmd_session cmd_messages
}

# Execution commands share this order; spawn also needs layout before state.
_load_runtime_libs() {
    _load_libs output paths locks git tmux "$@" state identity state_v2 events project profiles lifecycle
}

# Load libraries required for a command
# Usage: _load_libs_for_cmd <command>
_load_libs_for_cmd() {
    case "$1" in
        version|help|-v|--version|-h|--help)
            ;;
        fleet-local)
            _load_libs output locks git identity state_v2 lifecycle cmd_fleet_local
            ;;
        remote|fleet)
            _load_libs output cmd_fleet
            ;;
        state|events)
            _load_libs output locks identity state_v2 events cmd_foundation
            ;;
        snapshot)
            _load_libs output locks identity state_v2 core cmd_core
            ;;
        init|agent|capabilities|path)
            _load_libs output paths locks git identity state_v2 project profiles cmd_lifecycle
            ;;
        workflow)
            _load_runtime_libs
            _load_libs operations parallel messages limits workflow cmd_fleet workflow_approval workflow_data \
                workflow_plan workflow_retry workflow_runtime cmd_workflow
            ;;
        lifecycle|outcome|wait|adapter|resume|notify)
            _load_runtime_libs
            _load_libs notify operations cmd_evidence
            ;;
        exec|diff|review|provenance)
            _load_runtime_libs
            _load_libs operations cmd_operations
            ;;
        claim|scope|collision|resource|gate)
            _load_runtime_libs
            _load_libs operations parallel cmd_parallel
            ;;
        context|sync|land|integrate)
            _load_runtime_libs
            _load_libs notify hooks messages operations parallel integration integration_verified \
                integration_verified_actions kill limits spawn cmd_integration
            ;;
        du|gc|worktree)
            _load_libs output paths locks git tmux state identity state_v2 project profiles lifecycle parallel \
                integration worktree_ops cmd_worktree_ops
            ;;
        spawn)
            _load_runtime_libs layout
            _load_libs notify operations parallel hooks yaml spawn spawn_bulk github limits kill cmd_spawn cmd_list \
                cmd_session
            ;;
        list|switch|status|cycle-layout)
            _load_libs output locks state tmux identity state_v2 lifecycle operations layout github cmd_list \
                cmd_session
            ;;
        kill)
            _load_libs output paths locks git tmux state identity state_v2 events project lifecycle parallel notify \
                hooks messages kill limits spawn cmd_session
            ;;
        group|send|recv)
            _load_libs output state tmux locks identity state_v2 messages cmd_group cmd_messages
            ;;
        pr|template)
            _load_libs locks state identity state_v2 github template cmd_github
            ;;
        tail|broadcast|wait-idle)
            _load_libs locks state tmux identity state_v2 cmd_session_ops
            ;;
        regenerate)
            _load_runtime_libs layout
            _load_libs notify hooks yaml spawn cmd_queue cmd_evidence
            ;;
        doctor|cleanup)
            _load_libs paths maintenance tmux state git locks identity state_v2 output messages spawn cmd_queue \
                cmd_maintenance
            ;;
        dashboard|dashboard-exit)
            _load_libs locks state tmux identity state_v2 dashboard
            ;;
        tui)
            _load_libs output paths locks identity git tmux state state_v2 project profiles notify events \
                lifecycle limits maintenance tui
            ;;
        queue)
            _load_libs output state locks identity state_v2 limits spawn cmd_queue
            ;;
        completion)
            _load_libs completion_bash completion_zsh completion_fish completion cmd_completion
            ;;
        *)
            _load_libs output paths locks git tmux layout state completion dashboard github hooks yaml spawn \
                spawn_bulk kill limits maintenance tui cmd_spawn cmd_queue cmd_list cmd_session cmd_group \
                cmd_messages cmd_github cmd_session_ops cmd_maintenance cmd_completion
            ;;
    esac
}

# Export paths for downstream helpers (e.g., safe tmux run-shell bindings)
export HYDRA_LIB_DIR
export HYDRA_BIN_DIR
# Resolve the absolute path to the current hydra binary for secure bindings
HYDRA_BIN_CMD="${HYDRA_BIN_PATH}"
export HYDRA_BIN_CMD

# Initialize Hydra home directory
init_hydra_home() {
    if ! (umask 077; mkdir -p "$HYDRA_HOME") 2>/dev/null; then
        echo "Error: HYDRA_HOME is not writable: $HYDRA_HOME" >&2
        echo "Next: export HYDRA_HOME=\"\$HOME/.hydra\" and ensure that directory is writable, or see README Quick Start" >&2
        exit 1
    fi
    if [ ! -w "$HYDRA_HOME" ]; then
        echo "Error: HYDRA_HOME is not writable: $HYDRA_HOME" >&2
        echo "Next: chmod u+w \"$HYDRA_HOME\" or export HYDRA_HOME to a writable directory (see README Quick Start)" >&2
        exit 1
    fi
}

# Load the top-level usage and dispatcher after library discovery is ready.
_load_lib cli

# Command implementations live in lib/cmd_*.sh

main "$@"
