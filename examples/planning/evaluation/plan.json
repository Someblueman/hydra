{
  "schema_version": 1,
  "id": "planner-evaluation",
  "objective": "Verify all frozen candidate outputs with independently specified semantic checks.",
  "context": [],
  "assumptions": [
    "Frozen candidates are evaluated without repair; runtime scheduling and local placement are held fixed."
  ],
  "questions": [],
  "envelope": {
    "hosts": [
      "local"
    ],
    "tools": [
      "python3"
    ],
    "effects": [
      "worktree",
      "execute"
    ],
    "writes": [],
    "parallelism": 2,
    "timeout_seconds": 120,
    "artifact_bytes": 65536,
    "max_heads": 4,
    "disk_mb": 1,
    "retry_budget": 0,
    "repair_budget": 0
  },
  "steps": [
    {
      "id": "spawn-work",
      "role": "work",
      "kind": "spawn",
      "needs": [],
      "writes": [],
      "args": {
        "branch": "evaluation-work",
        "terminal_mode": "headless"
      }
    },
    {
      "id": "work",
      "role": "compose",
      "kind": "exec",
      "needs": [
        "spawn-work"
      ],
      "writes": [],
      "args": {
        "head": "evaluation-work",
        "argv": [
          "python3",
          "produce.py"
        ],
        "timeout": 90
      }
    },
    {
      "id": "spawn-check",
      "role": "work",
      "kind": "spawn",
      "needs": [],
      "writes": [],
      "args": {
        "branch": "evaluation-check",
        "terminal_mode": "headless"
      }
    },
    {
      "id": "check",
      "role": "verify",
      "kind": "exec",
      "needs": [
        "spawn-check",
        "work"
      ],
      "writes": [],
      "args": {
        "head": "evaluation-check",
        "argv": [
          "python3",
          "check.py"
        ],
        "timeout": 30
      }
    }
  ],
  "deliverables": [
    {
      "id": "report",
      "description": "Candidate outcomes with explicit errors",
      "step": "work",
      "output": "report",
      "destination": "run-artifact"
    }
  ],
  "checks": [
    {
      "id": "check",
      "method": "executable",
      "definition": "{\"predicate\":\"equals\",\"cases\":[{\"id\":\"fc-01-normalize-record\",\"expected\":\"pass\"},{\"id\":\"fc-02-reject-duplicate-config\",\"expected\":\"pass\"},{\"id\":\"fc-03-two-member-report\",\"expected\":\"pass\"},{\"id\":\"fr-01-schedule-metrics\",\"expected\":\"pass\"},{\"id\":\"fr-02-threshold-negative\",\"expected\":\"pass\"},{\"id\":\"fr-03-preserve-uncertainty\",\"expected\":\"pass\"},{\"id\":\"mm-01-exact-members\",\"expected\":\"pass\"},{\"id\":\"mm-02-hash-bound-members\",\"expected\":\"pass\"},{\"id\":\"mm-03-selected-and-skipped\",\"expected\":\"pass\"}]}",
      "step": "check",
      "input": "subject",
      "report": "check",
      "deliverable": "report"
    }
  ],
  "requirements": [
    {
      "id": "verified-cases",
      "criterion": "Every frozen semantic case matches and every declared corruption is rejected.",
      "deliverable": "report",
      "check": "check"
    }
  ],
  "data": {
    "schema_version": 1,
    "inputs": {
      "requests": {
        "type": "file",
        "path": "requests.json",
        "max_bytes": 4096
      },
      "oracle": {
        "type": "file",
        "path": "planner-evaluation-heldout-v2.json",
        "max_bytes": 24576
      }
    },
    "steps": {
      "work": {
        "inputs": {
          "requests": {
            "input": "requests"
          }
        },
        "outputs": {
          "report": {
            "type": "file",
            "path": "subject.json",
            "max_bytes": 8192
          }
        }
      },
      "check": {
        "inputs": {
          "subject": {
            "step": "work",
            "output": "report"
          },
          "oracle": {
            "input": "oracle"
          }
        },
        "outputs": {
          "check": {
            "type": "object",
            "path": "check.json",
            "max_bytes": 16384
          }
        }
      }
    }
  },
  "obligations": [
    {
      "id": "semantic-output",
      "requirement": "verified-cases",
      "intent_ref": "objective",
      "subject": {
        "deliverable": "report",
        "step": "work",
        "output": "report"
      },
      "criterion": "Every frozen semantic case matches and every declared corruption is rejected.",
      "evaluation": {
        "method": "executable",
        "check": "check"
      },
      "required_evidence": [
        "subject_sha256",
        "verdict",
        "evidence"
      ],
      "environment": {
        "hosts": [
          "local"
        ],
        "tools": [
          "python3"
        ],
        "effects": [
          "execute"
        ]
      },
      "completion_rule": "verdict=pass",
      "limitations": [
        "Nine finite cases; interface failures do not establish semantic planning improvement."
      ]
    }
  ]
}
