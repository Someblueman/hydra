{
  "schema_version": 1,
  "envelope": {
    "hosts": [
      "local"
    ],
    "tools": [
      "sh",
      "profile:opencode"
    ],
    "effects": [
      "worktree",
      "execute"
    ],
    "writes": [
      "feature-work-deterministic:slug.c",
      "feature-work-deterministic:catalog-slug"
    ],
    "parallelism": 2,
    "timeout_seconds": 900,
    "artifact_bytes": 262144,
    "max_heads": 2,
    "disk_mb": 1,
    "retry_budget": 0,
    "repair_budget": 0
  }
}
