{
  "schema_version": 1,
  "id": "performance-record-count-v1",
  "objective": "Qualify a bounded baseline versus candidate record-count workload through exclusive raw trials, deterministic paired uncertainty analysis, and an independent recomputation checker.",
  "context": [],
  "assumptions": [
    "records.txt, baseline.sh, candidate.sh, measure.sh, compose.sh, analyst.txt and assessor.txt are fixed source material.",
    "The measurement step is one exclusive process and is run only during an authorized measurement window.",
    "Ten trials per implementation are the fixed stopping rule; no retries or cherry-picking are allowed.",
    "The result may be target not established or invalid/insufficient measurement.",
    "Analysis and checking are deterministic repository scripts; no live provider or narrative verdict is used.",
    "The checker independently recomputes summaries and outcome from raw samples and fails on altered or truncated evidence."
  ],
  "questions": [],
  "deliverables": [
    {
      "id": "report",
      "description": "Sealed performance report with raw samples and analysis.",
      "step": "compose",
      "output": "report",
      "destination": "run-artifact"
    }
  ],
  "requirements": [
    {
      "id": "binding",
      "criterion": "Bind baseline, candidate, workload digest, environment, units and command forms.",
      "deliverable": "report",
      "check": "assessment"
    },
    {
      "id": "protocol",
      "criterion": "Show two warm-ups, ten trials per implementation, raw samples, failures and exclusive measurement.",
      "deliverable": "report",
      "check": "assessment"
    },
    {
      "id": "analysis",
      "criterion": "Report counts, median, nearest-rank p95, paired relative-change interval, and fixed stopping rule from raw samples.",
      "deliverable": "report",
      "check": "assessment"
    },
    {
      "id": "outcome",
      "criterion": "Classify target established only for ten valid paired trials, available p95s, candidate median at least 10% lower, and a paired 90% interval entirely below zero; otherwise classify accurately.",
      "deliverable": "report",
      "check": "assessment"
    },
    {
      "id": "limits",
      "criterion": "State that this bounded workload does not establish Hydra-wide performance or scalability.",
      "deliverable": "report",
      "check": "assessment"
    }
  ],
  "checks": [
    {
      "id": "assessment",
      "method": "assessment",
      "definition": "checker.py independently recomputes raw row validity, per-implementation median and p95, paired relative-change interval and outcome from the sealed report and raw samples; it emits a structured pass/fail object.",
      "step": "check",
      "input": "subject",
      "report": "assessment",
      "deliverable": "report"
    }
  ],
  "steps": [
    {
      "id": "spawn_work",
      "role": "work",
      "kind": "spawn",
      "needs": [],
      "writes": [],
      "args": {
        "branch": "performance-work-v2"
      }
    },
    {
      "id": "spawn_check",
      "role": "work",
      "kind": "spawn",
      "needs": [],
      "writes": [],
      "args": {
        "branch": "performance-check-v2"
      }
    },
    {
      "id": "measure",
      "role": "work",
      "kind": "exec",
      "needs": [
        "spawn_work"
      ],
      "writes": [],
      "args": {
        "head": "performance-work-v2",
        "argv": [
          "sh",
          "measure.sh"
        ],
        "timeout": 120
      }
    },
    {
      "id": "analyze",
      "role": "work",
      "kind": "exec",
      "needs": [
        "spawn_work",
        "measure"
      ],
      "writes": [],
      "args": {
        "head": "performance-work-v2",
        "argv": [
          "python3",
          "analyze.py"
        ],
        "timeout": 60
      }
    },
    {
      "id": "compose",
      "role": "compose",
      "kind": "exec",
      "needs": [
        "spawn_work",
        "measure",
        "analyze"
      ],
      "writes": [],
      "args": {
        "head": "performance-work-v2",
        "argv": [
          "sh",
          "compose.sh"
        ],
        "timeout": 60
      }
    },
    {
      "id": "check",
      "role": "verify",
      "kind": "exec",
      "needs": [
        "spawn_check",
        "compose",
        "measure"
      ],
      "writes": [],
      "args": {
        "head": "performance-check-v2",
        "argv": [
          "python3",
          "checker.py"
        ],
        "timeout": 60
      }
    }
  ],
  "data": {
    "schema_version": 1,
    "inputs": {
      "records": {
        "path": "records.txt",
        "type": "file",
        "max_bytes": 131072
      }
    },
    "steps": {
      "measure": {
        "inputs": {
          "records": {
            "input": "records"
          }
        },
        "outputs": {
          "raw": {
            "path": "raw.csv",
            "type": "file",
            "max_bytes": 32768
          },
          "workload_sha256": {
            "path": "workload.sha256",
            "type": "file",
            "max_bytes": 128
          },
          "environment": {
            "path": "environment.txt",
            "type": "file",
            "max_bytes": 4096
          }
        }
      },
      "analyze": {
        "inputs": {
          "raw": {
            "step": "measure",
            "output": "raw"
          }
        },
        "outputs": {
          "analysis": {
            "path": "analysis.json",
            "type": "file",
            "max_bytes": 32768
          }
        }
      },
      "compose": {
        "inputs": {
          "analysis": {
            "step": "analyze",
            "output": "analysis"
          },
          "raw": {
            "step": "measure",
            "output": "raw"
          },
          "workload_sha256": {
            "step": "measure",
            "output": "workload_sha256"
          },
          "environment": {
            "step": "measure",
            "output": "environment"
          }
        },
        "outputs": {
          "report": {
            "path": "report.json",
            "type": "file",
            "max_bytes": 131072
          }
        }
      },
      "check": {
        "inputs": {
          "subject": {
            "step": "compose",
            "output": "report"
          },
          "raw": {
            "step": "measure",
            "output": "raw"
          }
        },
        "outputs": {
          "assessment": {
            "path": "assessment",
            "type": "object",
            "max_bytes": 8192
          }
        }
      }
    }
  },
  "envelope": {
    "hosts": [
      "local"
    ],
    "tools": [
      "sh",
      "python3"
    ],
    "effects": [
      "worktree",
      "execute"
    ],
    "writes": [],
    "parallelism": 2,
    "timeout_seconds": 900,
    "artifact_bytes": 524288,
    "max_heads": 2,
    "disk_mb": 2,
    "retry_budget": 0,
    "repair_budget": 0
  }
}
