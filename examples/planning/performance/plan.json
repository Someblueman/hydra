{
  "schema_version": 1,
  "id": "performance-record-count-v2",
  "objective": "Qualify a bounded baseline versus candidate record-count workload through exclusive raw trials, deterministic paired uncertainty analysis, and an independent recomputation checker.",
  "context": [
    "SPEC.md"
  ],
  "assumptions": [
    "The measurement step is one exclusive process and is run only during an authorized measurement window.",
    "Ten trials per implementation are the fixed stopping rule; no retries or cherry-picking are allowed.",
    "The result may be target not established or invalid/insufficient measurement.",
    "The checker independently recomputes summaries and outcome from raw samples and fails on altered or truncated evidence.",
    "measure.py, analyze.py and checker.py are fixed deterministic source material.",
    "The checker validates the sealed manifest against current source and workload hashes."
  ],
  "questions": [],
  "deliverables": [
    {
      "id": "report",
      "description": "Sealed performance report with raw samples and analysis.",
      "step": "compose",
      "output": "report",
      "destination": "run-artifact"
    }
  ],
  "requirements": [
    {
      "id": "binding",
      "criterion": "Bind exact baseline.sh and candidate.sh hashes, records.txt hash and byte count, command forms, host/OS/Python environment, nanosecond units, and protocol metadata.",
      "deliverable": "report",
      "check": "performance-check"
    },
    {
      "id": "protocol",
      "criterion": "Show two warm-ups, ten trials per implementation, raw samples, failures and exclusive measurement.",
      "deliverable": "report",
      "check": "performance-check"
    },
    {
      "id": "analysis",
      "criterion": "Report counts, median, nearest-rank p95, paired relative-change interval, and fixed stopping rule from raw samples.",
      "deliverable": "report",
      "check": "performance-check"
    },
    {
      "id": "outcome",
      "criterion": "Classify target established only for ten valid alternating trial pairs when the median paired relative change is at most -10% and its 90% bootstrap upper bound is below zero; otherwise classify accurately.",
      "deliverable": "report",
      "check": "performance-check"
    },
    {
      "id": "limits",
      "criterion": "State that this bounded workload does not establish Hydra-wide performance or scalability.",
      "deliverable": "report",
      "check": "performance-check"
    }
  ],
  "checks": [
    {
      "id": "performance-check",
      "method": "executable",
      "definition": "{\"predicate\":\"equals\",\"cases\":[{\"id\":\"performance-outcome\",\"expected\":\"pass\"}]}",
      "step": "check",
      "input": "subject",
      "report": "assessment",
      "deliverable": "report"
    }
  ],
  "steps": [
    {
      "id": "spawn_work",
      "role": "work",
      "kind": "spawn",
      "needs": [],
      "writes": [],
      "args": {
        "branch": "performance-work-v2",
        "terminal_mode": "headless"
      }
    },
    {
      "id": "spawn_check",
      "role": "work",
      "kind": "spawn",
      "needs": [],
      "writes": [],
      "args": {
        "branch": "performance-check-v2",
        "terminal_mode": "headless"
      }
    },
    {
      "id": "measure",
      "role": "work",
      "kind": "exec",
      "needs": [
        "spawn_work",
        "spawn_check"
      ],
      "writes": [],
      "args": {
        "head": "performance-work-v2",
        "argv": [
          "python3",
          "measure.py"
        ],
        "timeout": 120
      }
    },
    {
      "id": "compose",
      "role": "compose",
      "kind": "exec",
      "needs": [
        "spawn_work",
        "measure"
      ],
      "writes": [],
      "args": {
        "head": "performance-work-v2",
        "argv": [
          "python3",
          "analyze.py"
        ],
        "timeout": 60
      }
    },
    {
      "id": "check",
      "role": "verify",
      "kind": "exec",
      "needs": [
        "spawn_check",
        "compose",
        "measure"
      ],
      "writes": [],
      "args": {
        "head": "performance-check-v2",
        "argv": [
          "python3",
          "checker.py"
        ],
        "timeout": 60
      }
    }
  ],
  "data": {
