{
  "schema_version": 1,
  "id": "research-scheduling-deterministic-v1",
  "objective": "Deliver a completed research report comparing non-preemptive FCFS and SJF on the supplied jobs.csv trace (12 synthetic jobs, one server, exact known durations): mean waiting and turnaround per policy, nearest-rank p95 turnaround and maximum wait per policy with explanation of disagreement with means, worst-wait job per policy with the observed-wait versus starvation distinction, an explicit recommendation under p95 turnaround at most 22 and maximum wait at most 16 that plainly reports if neither policy qualifies, a retained schedule and metric reproducibility appendix, and stated scope limits. Measurement produces sealed evidence, an analyst interprets it, composition emits the final report with its reproducibility appendix, and an independent assessor verifies the sealed final artifact against SPEC.md. A correct report must state a failed constraint rather than relax the limits.",
  "context": [
    "SPEC.md"
  ],
  "assumptions": [
    "jobs.csv and SPEC.md are authoritative bounded source material.",
    "research_report.py and research_check.py are deterministic independent implementations; no provider is called.",
    "A valid negative recommendation that neither policy qualifies completes the bounded investigation."
  ],
  "questions": [],
  "deliverables": [
    {
      "id": "report",
      "description": "The completed research report (report.md) composed from the analyst draft plus the sealed metrics and schedule, including the reproducibility appendix; delivered as a run artifact.",
      "step": "compose",
      "output": "report",
      "destination": "run-artifact"
    }
  ],
  "requirements": [
    {
      "id": "means",
      "criterion": "Report mean waiting time and mean turnaround for both FCFS and SJF, with waiting = start - arrival and turnaround = finish - arrival.",
      "deliverable": "report",
      "check": "assessment"
    },
    {
      "id": "tails",
      "criterion": "Report p95 turnaround by nearest rank (ceil(0.95*n)) and the maximum wait for each policy, and explain why those can disagree with mean improvements.",
      "deliverable": "report",
      "check": "assessment"
    },
    {
      "id": "fairness",
      "criterion": "Identify the job with the worst wait for each policy using its schedule, and distinguish observed long waits from proof of starvation.",
      "deliverable": "report",
      "check": "assessment"
    },
    {
      "id": "recommendation",
      "criterion": "Choose a policy for this trace subject to p95 turnaround at most 22 and maximum wait at most 16, or explicitly report that neither policy qualifies; state both constraint checks explicitly and do not relax the limits.",
      "deliverable": "report",
      "check": "assessment"
    },
    {
      "id": "reproduce",
      "criterion": "Identify the data and method, provide enough results to reproduce the recommendation, and retain the schedule and metric appendix.",
      "deliverable": "report",
      "check": "assessment"
    },
    {
      "id": "limits",
      "criterion": "Explain the limits of 12 synthetic jobs, exact-duration knowledge, one server, non-preemption, and lack of general production evidence.",
      "deliverable": "report",
      "check": "assessment"
    }
  ],
  "checks": [
    {
      "id": "assessment",
      "method": "executable",
      "definition": "{\"predicate\":\"equals\",\"cases\":[{\"id\":\"fcfs\",\"expected\":{\"mean_wait\":11.583333333333334,\"mean_turnaround\":14.166666666666666,\"p95_turnaround\":19,\"max_wait\":18,\"worst_wait_job\":\"L\"}},{\"id\":\"sjf\",\"expected\":{\"mean_wait\":4.0,\"mean_turnaround\":6.583333333333333,\"p95_turnaround\":31,\"max_wait\":22,\"worst_wait_job\":\"A\"}},{\"id\":\"recommendation\",\"expected\":{\"recommendation\":\"neither qualifies\",\"constraint_checks\":{\"FCFS\":false,\"SJF\":false}}}]}",
      "step": "check",
      "input": "subject",
      "report": "assessment",
      "deliverable": "report"
    }
  ],
  "obligations": [
    {"id":"means","requirement":"means","intent_ref":"objective","subject":{"deliverable":"report","step":"compose","output":"report"},"criterion":"Report mean waiting time and mean turnaround for both policies.","evaluation":{"method":"executable","check":"assessment"},"required_evidence":["subject_sha256","verdict","evidence"],"environment":{"hosts":["local"],"tools":["sh"],"effects":["execute"]},"completion_rule":"verdict=pass","limitations":["bounded trace"]},
    {"id":"tails","requirement":"tails","intent_ref":"objective","subject":{"deliverable":"report","step":"compose","output":"report"},"criterion":"Report nearest-rank p95 turnaround and maximum wait.","evaluation":{"method":"executable","check":"assessment"},"required_evidence":["subject_sha256","verdict","evidence"],"environment":{"hosts":["local"],"tools":["sh"],"effects":["execute"]},"completion_rule":"verdict=pass","limitations":["bounded trace"]},
    {"id":"fairness","requirement":"fairness","intent_ref":"objective","subject":{"deliverable":"report","step":"compose","output":"report"},"criterion":"Identify worst waits and distinguish observation from starvation proof.","evaluation":{"method":"executable","check":"assessment"},"required_evidence":["subject_sha256","verdict","evidence"],"environment":{"hosts":["local"],"tools":["sh"],"effects":["execute"]},"completion_rule":"verdict=pass","limitations":["bounded trace"]},
    {"id":"recommendation","requirement":"recommendation","intent_ref":"objective","subject":{"deliverable":"report","step":"compose","output":"report"},"criterion":"State both constraints and a recommendation without relaxing them.","evaluation":{"method":"executable","check":"assessment"},"required_evidence":["subject_sha256","verdict","evidence"],"environment":{"hosts":["local"],"tools":["sh"],"effects":["execute"]},"completion_rule":"verdict=pass","limitations":["bounded trace"]},
    {"id":"reproduce","requirement":"reproduce","intent_ref":"objective","subject":{"deliverable":"report","step":"compose","output":"report"},"criterion":"Retain the method, results, schedule and metric appendix.","evaluation":{"method":"executable","check":"assessment"},"required_evidence":["subject_sha256","verdict","evidence"],"environment":{"hosts":["local"],"tools":["sh"],"effects":["execute"]},"completion_rule":"verdict=pass","limitations":["bounded trace"]},
    {"id":"limits","requirement":"limits","intent_ref":"objective","subject":{"deliverable":"report","step":"compose","output":"report"},"criterion":"State all bounded-study limitations.","evaluation":{"method":"executable","check":"assessment"},"required_evidence":["subject_sha256","verdict","evidence"],"environment":{"hosts":["local"],"tools":["sh"],"effects":["execute"]},"completion_rule":"verdict=pass","limitations":["bounded trace"]}
  ],
  "steps": [
    {
      "id": "spawn-work",
      "role": "work",
      "kind": "spawn",
      "needs": [],
      "writes": [],
      "args": {
        "branch": "research-work-deterministic"
      }
    },
    {
      "id": "analyze",
      "role": "work",
      "kind": "exec",
      "needs": [
        "spawn-work"
      ],
      "writes": [],
      "args": {
        "head": "research-work-deterministic",
        "argv": [
          "sh",
          "-c",
          "python3 research_report.py"
        ],
        "timeout": 60
      }
    },
    {
      "id": "compose",
      "role": "compose",
      "kind": "exec",
      "needs": [
        "analyze"
      ],
      "writes": [],
      "args": {
        "head": "research-work-deterministic",
        "argv": [
          "sh",
          "compose_deterministic.sh"
        ],
        "timeout": 30
      }
    },
    {
      "id": "spawn-check",
      "role": "work",
      "kind": "spawn",
      "needs": [],
      "writes": [],
      "args": {
        "branch": "research-check-deterministic"
      }
    },
    {
      "id": "check",
      "role": "verify",
      "kind": "exec",
      "needs": [
        "spawn-check",
        "compose"
      ],
      "writes": [],
      "args": {
        "head": "research-check-deterministic",
        "argv": [
          "sh",
          "-c",
          "python3 research_check.py"
        ],
        "timeout": 60
      }
    }
  ],
  "data": {
    "schema_version": 1,
    "inputs": {
      "jobs": {
        "path": "jobs.csv",
        "type": "file",
        "max_bytes": 4096
      }
    },
    "steps": {
      "analyze": {
        "inputs": {
          "jobs": {
            "input": "jobs"
          }
        },
        "outputs": {
          "analysis": {
            "path": "report.json",
            "type": "file",
            "max_bytes": 65536
          }
        }
      },
      "compose": {
        "inputs": {
          "analysis": {
            "step": "analyze",
            "output": "analysis"
          }
        },
        "outputs": {
          "report": {
            "path": "report.json",
            "type": "file",
            "max_bytes": 65536
          }
        }
      },
      "check": {
        "inputs": {
          "subject": {
            "step": "compose",
            "output": "report"
          },
          "jobs": {
            "input": "jobs"
          }
        },
        "outputs": {
          "assessment": {
            "path": "assessment",
            "type": "object",
            "max_bytes": 16384
          }
        }
      }
    }
  },
  "envelope": {
    "hosts": [
      "local"
    ],
    "tools": [
      "sh"
    ],
    "effects": [
      "worktree",
      "execute"
    ],
    "writes": [],
    "parallelism": 2,
    "timeout_seconds": 900,
    "artifact_bytes": 262144,
    "max_heads": 2,
    "disk_mb": 1,
    "retry_budget": 0,
    "repair_budget": 0
  }
}
