{
  "schema_version": 1,
  "id": "staged-stage1",
  "objective": "Produce a sealed stage-1 finding from the bounded manifest.",
  "context": [],
  "assumptions": [],
  "questions": [],
  "envelope": {
    "hosts": [
      "local"
    ],
    "tools": [
      "python3"
    ],
    "effects": [
      "worktree",
      "execute"
    ],
    "writes": [],
    "parallelism": 1,
    "timeout_seconds": 180,
    "artifact_bytes": 32768,
    "max_heads": 1,
    "disk_mb": 1,
    "retry_budget": 0,
    "repair_budget": 0
  },
  "steps": [
    {
      "id": "spawn",
      "role": "work",
      "kind": "spawn",
      "needs": [],
      "writes": [],
      "args": {
        "branch": "staged-stage1",
        "terminal_mode": "headless"
      }
    },
    {
      "id": "compose",
      "role": "compose",
      "kind": "exec",
      "needs": [
        "spawn"
      ],
      "writes": [],
      "args": {
        "head": "staged-stage1",
        "argv": [
          "python3",
          "stage1_run.py"
        ],
        "timeout": 30
      }
    },
    {
      "id": "verify",
      "role": "verify",
      "kind": "exec",
      "needs": [
        "compose"
      ],
      "writes": [],
      "args": {
        "head": "staged-stage1",
        "argv": [
          "python3",
          "stage1_check.py"
        ],
        "timeout": 30
      }
    }
  ],
  "deliverables": [
    {
      "id": "report",
      "description": "Sealed stage-1 finding",
      "step": "compose",
      "output": "report",
      "destination": "run-artifact"
    }
  ],
  "checks": [
    {
      "id": "check",
      "method": "executable",
      "definition": "{\"predicate\":\"equals\",\"cases\":[{\"id\":\"stage1-finding\",\"expected\":\"pass\"}]}",
      "step": "verify",
      "input": "subject",
      "report": "check",
      "deliverable": "report"
    }
  ],
  "requirements": [
    {
      "id": "stage1",
      "criterion": "Stage1 finding is source-bound and independently checked.",
      "deliverable": "report",
      "check": "check"
    }
  ],
  "data": {
    "schema_version": 1,
    "inputs": {
      "manifest": {
        "path": "manifest.json",
        "type": "file",
        "max_bytes": 4096
      }
    },
    "steps": {
      "compose": {
        "inputs": {
          "manifest": {
            "input": "manifest"
          }
        },
        "outputs": {
          "report": {
            "type": "file",
            "path": "finding.json",
            "max_bytes": 8192
          }
        }
      },
      "verify": {
        "inputs": {
          "subject": {
            "step": "compose",
            "output": "report"
          },
          "manifest": {
            "input": "manifest"
          }
        },
        "outputs": {
          "check": {
            "type": "object",
            "path": "check.json",
            "max_bytes": 8192
          }
        }
      }
    }
  },
  "obligations": [
    {
      "id": "stage1-check",
      "requirement": "stage1",
      "intent_ref": "objective",
      "subject": {
        "deliverable": "report",
        "step": "compose",
        "output": "report"
      },
      "criterion": "Stage1 finding is source-bound and independently checked.",
      "evaluation": {
        "method": "executable",
        "check": "check"
      },
      "required_evidence": [
        "subject_sha256",
        "verdict",
        "evidence"
      ],
      "environment": {
        "hosts": [
          "local"
        ],
        "tools": [
          "python3"
        ],
        "effects": [
          "execute"
        ]
      },
      "completion_rule": "verdict=pass",
      "limitations": [
        "Finite staged fixture."
      ]
    }
  ]
}
