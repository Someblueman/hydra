{
  "version": 1,
  "roots": [
    "bin/hydra",
    "lib",
    "scripts",
    "tests",
    "install.sh",
    "uninstall.sh",
    "assets/demos",
    "src",
    "Makefile",
    "docs/quality",
    "quality.json",
    "examples/planning"
  ],
  "exclude": [],
  "tools": {
    "make": {
      "command": [
        "make"
      ],
      "version": "3.81",
      "version_args": [
        "--version"
      ],
      "install": []
    },
    "shellcheck": {
      "command": [
        "shellcheck"
      ],
      "version": "0.11.0",
      "version_args": [
        "--version"
      ],
      "install": []
    },
    "clang-tidy": {
      "command": [
        "sh",
        "scripts/clang-tidy.sh"
      ],
      "version": "22.1.8",
      "version_args": [
        "--version"
      ],
      "install": []
    },
    "shell-lint": {
      "command": [
        "sh",
        "scripts/lint-shell.sh"
      ],
      "version": "0.11.0",
      "version_args": [
        "--version"
      ],
      "install": []
    },
    "c-incremental": {
      "command": [
        "sh",
        "scripts/quality-c-incremental.sh"
      ],
      "version": "22.1.8",
      "version_args": [
        "--version"
      ],
      "install": []
    }
  },
  "checks": [
    {
      "name": "Hydra native shell lint (ShellCheck and dash)",
      "tool": "shell-lint",
      "args": [],
      "patterns": [
        "*.sh",
        "bin/hydra"
      ],
      "files": true,
      "stage": "fast",
      "failure_codes": [
        1,
        2
      ],
      "inputs": [
        "scripts/lint-shell.sh",
        "**/.shellcheckrc"
      ]
    },
    {
      "name": "Hydra C complexity regression gate",
      "tool": "c-incremental",
      "args": [],
      "patterns": [
        "*.c",
        "*.h",
        "*.inc"
      ],
      "files": true,
      "stage": "full",
      "failure_codes": [
        1,
        2
      ],
      "scope": "translation-units",
      "inputs": [
        "Makefile",
        "scripts/quality-c.sh",
        "scripts/quality-c-incremental.sh",
        "docs/quality/*.tsv",
        "scripts/native-tests.mk"
      ]
    },
    {
      "name": "Hydra C analysis and complexity regression gate",
      "tool": "make",
      "args": [
        "quality-c"
      ],
      "patterns": [
        "*.c",
        "*.h",
        "*.inc",
        "Makefile",
        "scripts/quality-c.sh",
        "docs/quality/*.tsv",
        "quality.json",
        "scripts/native-tests.mk"
      ],
      "files": false,
      "stage": "manual",
      "failure_codes": [
        1,
        2
      ]
    }
  ],
  "size": {
    "limit": 500,
    "mode": "review"
  }
}
