#!/bin/sh

if [ -n "${HYDRA_TEST_TMUX_SOCKET:-}" ] && [ -n "${HYDRA_REAL_TMUX:-}" ]; then
    exec "$HYDRA_REAL_TMUX" -L "$HYDRA_TEST_TMUX_SOCKET" "$@"
fi

case "${1:-}" in
    -V) printf 'tmux 3.4\n' ;;
    list-sessions)
        # With FAKE_TMUX_ACTIVITY (a file of "session time" lines, where the
        # time "now" stands for output at this moment) every listed session
        # carries its window activity, as the control centre asks for it.
        if [ -f "${FAKE_TMUX_ACTIVITY:-}" ]; then
            now="$(date +%s)"
            printf '%s' "${FAKE_TMUX_SESSIONS:-}" | tr ',' '\n' | while IFS= read -r session || [ -n "$session" ]; do
                [ -n "$session" ] || continue
                activity="$(awk -v name="$session" '$1 == name { print $2; exit }' "$FAKE_TMUX_ACTIVITY")"
                [ "$activity" != now ] || activity="$now"
                printf '%s:%s \n' "$session" "$activity"
            done
        else
            printf '%s' "${FAKE_TMUX_SESSIONS:-}" | tr ',' '\n'
        fi
        ;;
    list-panes)
        printf '%s' "${FAKE_TMUX_SESSIONS:-}" | tr ',' '\n' | while IFS= read -r session; do
            [ -n "$session" ] || continue
            printf '%s\t0\t0\t0\tsh\t0\n' "$session"
        done
        ;;
    display-message) printf '%s\n' "${FAKE_TMUX_CURRENT_SESSION:-}" ;;
    has-session)
        wanted=""
        while [ $# -gt 0 ]; do
            if [ "$1" = -t ] && [ $# -ge 2 ]; then wanted="$2"; break; fi
            shift
        done
        printf '%s' "${FAKE_TMUX_SESSIONS:-}" | tr ',' '\n' | grep -Fqx "$wanted"
        ;;
    capture-pane)
        # FAKE_TMUX_CAPTURE names a file whose text is every pane's.
        if [ -f "${FAKE_TMUX_CAPTURE:-}" ]; then cat "$FAKE_TMUX_CAPTURE"; exit 0; fi
        printf 'pane text q :kill \033[2J remains display-only\n'
        ;;
    *) exit 1 ;;
esac
